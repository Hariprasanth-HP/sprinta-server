generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id String @id @db.Uuid
  email String @unique

  name String @db.VarChar(20)

  password String? @db.VarChar(100)

  picture String? @db.VarChar(250)

  provider AuthProvider @default(LOCAL)

  googleId String? @db.Uuid

  createdAt DateTime @default(now())

  memberships TeamMember[]

  tasksAssignedBy Task[] @relation("TaskAssignedBy")

  tasksAssignedTo Task[] @relation("TaskAssignee")

  createdTeams Team[] @relation("CreatedTeams")

  projects Project[]

  projectMembers ProjectMember[]

  createdMembers TeamMember[] @relation("AddedById")

  activities Activity[]

  notifications Notification[]
}

enum Severity {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  COMMENT_ADDED
  MENTIONED
  SYSTEM
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectRole {
  MANAGER
  EDITOR
  VIEWER
}

model Team {
  id        Int          @id @default(autoincrement())
  name      String       @db.VarChar(20)
  about     String       @db.VarChar(100)
  createdAt DateTime     @default(now())
  creatorId String       @db.Uuid
  creator   User         @relation("CreatedTeams", fields: [creatorId], references: [id])
  members   TeamMember[]
  projects  Project[]
}

model TeamMember {
  id     Int  @id @default(autoincrement())
  team   Team @relation(fields: [teamId], references: [id])
  teamId Int

  // <-- user is optional until they sign up
  userId String? @db.Uuid

  user User? @relation(fields: [userId], references: [id])

  // You directly store what admin enters
  email String // required
  name  String?
  role TeamRole @default(MEMBER)

  addedAt   DateTime @default(now())
  addedById String?  @db.Uuid
  addedBy   User?    @relation("AddedById", fields: [addedById], references: [id])

  @@unique([teamId, email], name: "uniq_team_email")
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now())

  teamId Int?
  team   Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  creatorId String? @db.Uuid
  creator   User?   @relation(fields: [creatorId], references: [id])

  tasks  Task[]
  status TaskStatus[]

  lists List[]

  members ProjectMember[]

  @@index([creatorId])
}

model ProjectMember {
  id Int @id @default(autoincrement())

  projectId Int
  userId    String @db.Uuid

  role ProjectRole @default(VIEWER)

  addedAt DateTime @default(now())

  project Project @relation(fields: [projectId],references: [id],onDelete: Cascade)

  user User @relation(fields: [userId],references: [id])

  @@unique([projectId, userId], name: "uniq_project_user")
}

model List {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  projectId Int
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks Task[]
}

model Task {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now())

  priority Priority  @default(MEDIUM)
  dueDate  DateTime?

  parentTaskId Int?
  parentTask   Task?  @relation("TaskSubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks     Task[] @relation("TaskSubTasks")

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  listId Int?
  list   List? @relation(fields: [listId], references: [id])

  assignedById String @db.Uuid
  assignedBy   User?  @relation("TaskAssignedBy", fields: [assignedById], references: [id])

  assigneeId String? @db.Uuid
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  activities Activity[]

  statusId Int?
  status   TaskStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)

  assets Asset[]

  @@index([projectId])
  @@index([parentTaskId])
  @@index([assignedById])
  @@index([assigneeId])
  @@index([statusId])
}

enum AssetType {
  IMAGE
  VIDEO
  FILE
}

model Asset {
  id       Int       @id @default(autoincrement())
  url      String
  publicId String
  type     AssetType

  taskId     Int?
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  activityId Int?
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([activityId])
}

model TaskStatus {
  id        Int      @id @default(autoincrement())
  name      String
  color     String? // optional display color (e.g. "#f59e0b" or "blue")
  sortOrder Int? // optional order within project
  createdAt DateTime @default(now())

  // Scope statuses to a project so users can create custom statuses per project
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks Task[] // inverse relation

  @@unique([projectId, name]) // prevents duplicate status names in same project
  @@index([projectId])
}

enum ActivityKind {
  COMMENT // user comment with replies
  TASK_UPDATE // any change to a Task field
  SYSTEM // automated events
  NOTE // optional general notes
  WORKLOG // time entries if needed later
}

model Activity {
  id          Int          @id @default(autoincrement())
  kind        ActivityKind
  description String? // comment text OR human-readable summary of update
  metadata    Json? // structured data: field diffs, actor, etc.
  createdAt   DateTime     @default(now())

  isDeleted Boolean @default(false)

  // RELATIONS
  taskId Int?
  task   Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // COMMENT THREADING (self relation)
  parentId Int?
  parent   Activity?  @relation("ActivityReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Activity[] @relation("ActivityReplies")

  assets Asset[]

  @@index([taskId])
  @@index([userId])
  @@index([kind, createdAt])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  severity  Severity         @default(NORMAL)
  title     String           @db.VarChar(200)
  message   String?          @db.VarChar(500)
  link      String?
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  readAt    DateTime?

  @@index([userId, isRead])
  @@index([userId, createdAt])
}


